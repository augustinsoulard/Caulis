# ============================================================
#  caulis — configuration locale (.env)
#  Copiez ce fichier en ".env" (le vrai .env n'est JAMAIS committé,
#  il est dans .gitignore) et renseignez vos chemins.
#  Le package charge automatiquement le .env à son chargement.
# ============================================================

# Fichier des SECRETS (identifiants PostgreSQL PGUSER/PGPASSWORD, clés API)
# — externe au dépôt, jamais committé
CAULIS_RENVIRON=D:/NextCloud/Documents/A_PERSO/Administratif/hz/.Renviron

# Outils externes
CAULIS_EXIFTOOL=D:/Logiciel/ExifTool/exiftool.exe

# Dossiers de données externes (hors dépôt)
CAULIS_DRIVE_PARTAGE=G:/Drive partagés
CAULIS_TEMP=D:/TEMP

# Racine des données du projet (défaut : "data" relatif au dépôt)
#CAULIS_DATA_DIR=data
